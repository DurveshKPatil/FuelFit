# Database
DATABASE_URL="postgresql://user:password@localhost:5432/protein_store?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Generate a strong secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"

# Amazon Affiliate
# Your Amazon Associate tag (without the hyphen prefix)
AMAZON_AFFILIATE_TAG="fuel-21"
# Amazon domain (default: amazon.in)
AMAZON_DOMAIN="amazon.in"

# Optional OAuth provider (Google) - only needed if you enable "Sign in with Google"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (Nodemailer) - used for transactional emails
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="FuelFit <noreply@fuelfit.com>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
